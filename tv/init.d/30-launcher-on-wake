#!/bin/sh
# Opens the launcher when the TV is turned on with the remote. When something else turned it on
# (the Xbox over HDMI-CEC, say) it stays where that put it. Watches the TV's power state from
# the background; the Homebrew Channel runs this at boot.
#
#   30-launcher-on-wake          start the watcher (what the Homebrew Channel does)
#   30-launcher-on-wake states   print power states as they change, for testing
#
# Its log is /run/minimal-launcher/launcher-on-wake.log.

LAUNCHER=com.minimal.launcher
# /run, not /tmp: only root can write there, so no app can plant a link for root to follow.
# (/var/run on webOS is a link into /tmp.)
RUN=/run/minimal-launcher
LOG=$RUN/launcher-on-wake.log
PIDFILE=$RUN/launcher-on-wake.pid
# How long the TV gets to finish waking and show what it resumes to before we look.
SETTLE=6
BOOT_SETTLE=20

# luna-send only answers with a terminal attached; script(1) gives it one.
luna() {
  script -q -c "luna-send -n 1 $1 '$2'" /dev/null < /dev/null | tr -d '\r'
}

field() {
  sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p"
}

log() {
  echo "$(date '+%F %T') $*" >> "$LOG"
}

foreground() {
  luna luna://com.webos.applicationManager/getForegroundAppInfo '{}' | field appId
}

launch() {
  luna luna://com.webos.applicationManager/launch "{\"id\":\"$LAUNCHER\"}" > /dev/null
}

# The TV knows what turned it on: "remoteKey" for the remote's power button.
open_launcher() {
  sleep "$1"
  reason=$(luna luna://com.webos.service.tvpower/power/getPowerOnReason '{}' | field reason)
  case "$reason" in
    remoteKey) ;;
    *) log "turned on by ${reason:-unknown}; leaving it on $(foreground)"; return ;;
  esac
  app=$(foreground)
  [ "$app" != "$LAUNCHER" ] && log "turned on by the remote, on ${app:-nothing}; opening the launcher" && launch
  # A device woken with the TV (the Stream Box) can take the screen a few seconds later over
  # HDMI-CEC. Bring the launcher back if it does, for the first 20 seconds.
  for wait in 5 5 5 5; do
    sleep "$wait"
    app=$(foreground)
    case "$app" in
      com.webos.app.hdmi*|com.webos.app.externalinput*) log "$app took the screen; reopening the launcher"; launch ;;
    esac
  done
}

# One line per power state change, as the TV reports it.
states() {
  script -q -c "luna-send -i luna://com.webos.service.tvpower/power/getPowerState '{\"subscribe\":true}'" /dev/null < /dev/null |
    tr -d '\r' | while read -r line; do
      state=$(echo "$line" | field state)
      [ -n "$state" ] && echo "$state"
    done
}

watch() {
  # Right after a boot, treat it as a power-on. A later start (reinstalling this) isn't one.
  [ "$(cut -d. -f1 /proc/uptime)" -lt 180 ] && open_launcher "$BOOT_SETTLE" &
  while true; do
    last=""
    states | while read -r state; do
      [ "$state" = "$last" ] && continue
      log "power: ${last:-start} -> $state"
      # Only a real power-on counts: not leaving the screen-off mode or a screensaver.
      case "$last" in
        Suspend|"Active Standby"|"Power Off"|Off)
          [ "$state" = Active ] && open_launcher "$SETTLE" &
          ;;
      esac
      last=$state
    done
    # The subscription ended (the power service restarted); subscribe again.
    sleep 5
  done
}

# Whether the pid file names a live copy of this watcher (and not some other process).
running() {
  pid=$(cat "$PIDFILE" 2>/dev/null)
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  grep -q "launcher-on-wake" "/proc/$pid/cmdline" 2>/dev/null
}

case "$1" in
  states)
    states
    ;;
  stop)
    # setsid made the watcher a process group leader: end the group, so its listener and any
    # pending power-on step go with it.
    if running; then kill -- "-$(cat "$PIDFILE")"; fi
    rm -f "$PIDFILE"
    ;;
  run)
    mkdir -p "$RUN" && chmod 700 "$RUN"
    echo $$ > "$PIDFILE"
    log "watching the power state"
    watch
    ;;
  *)
    # Started by the Homebrew Channel: run in the background, once.
    mkdir -p "$RUN" && chmod 700 "$RUN"
    if running; then exit 0; fi
    setsid "$0" run > /dev/null 2>&1 < /dev/null &
    ;;
esac
