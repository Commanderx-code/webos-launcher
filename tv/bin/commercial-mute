#!/bin/sh
# Runs on each press of the remote's Mute button (via LG Input Hook), alongside the TV's own
# mute, which still happens. If the press muted the TV, this unmutes it again after a commercial
# break's length; if the press unmuted it, this cancels that pending unmute.
#
#   commercial-mute [seconds]   default 150 (2½ minutes)

SECONDS_MUTED=${1:-150}
# /run, not /tmp: only root can write there (see 30-launcher-on-wake).
RUN=/run/minimal-launcher
PIDFILE=$RUN/commercial-mute.pid

mkdir -p "$RUN" && chmod 700 "$RUN"

# luna-send only answers with a terminal attached; script(1) gives it one.
luna() {
  script -q -c "luna-send -n 1 $1 '$2'" /dev/null < /dev/null | tr -d '\r'
}

# The mute the remote's button toggles (com.webos.audio has a separate one that it doesn't).
muted() {
  luna luna://com.webos.service.audio/master/getVolume '{}' | grep -q '"muteStatus": *true'
}

# Cancel a pending unmute from an earlier press, if the pid file names a live copy of this script.
pid=$(cat "$PIDFILE" 2>/dev/null)
case "$pid" in
  ''|*[!0-9]*) ;;
  *) grep -q "commercial-mute" "/proc/$pid/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null ;;
esac
rm -f "$PIDFILE"

# Give the TV a moment to act on the key itself.
sleep 1
muted || exit 0

(
  sleep "$SECONDS_MUTED"
  muted && luna luna://com.webos.service.audio/master/muteVolume '{"mute":false}' > /dev/null
  rm -f "$PIDFILE"
) > /dev/null 2>&1 < /dev/null &
echo $! > "$PIDFILE"
