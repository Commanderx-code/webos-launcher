#!/bin/sh
# A remote button for the launcher's sidebar, via LG Input Hook: brings the launcher up with its
# sidebar open from anywhere. Pressed on the launcher, it opens or closes the sidebar.
# luna-send only answers with a terminal attached; script(1) gives it one. The address and the
# message go through the environment, so nothing in them is read as shell syntax.
LUNA_URI=luna://com.webos.applicationManager/launch \
LUNA_PAYLOAD='{"id":"com.minimal.launcher","params":{"sidebar":true}}' \
  script -q -c 'luna-send -n 1 "$LUNA_URI" "$LUNA_PAYLOAD"' /dev/null < /dev/null > /dev/null
